# ============================================================================
# .gitignore - deepvision-cifar10-classifier
# Sections : Python | Jupyter | ML/Data | Docker/MLflow | Tests/Qualité | IDE | OS | Secrets
# ============================================================================

# ---------------------------------------------------------------------------
# Python — environnements virtuels et caches
# ---------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
.python-version

__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Outils packaging modernes
.pdm-python
.pdm-build/
__pypackages__/

# ---------------------------------------------------------------------------
# Jupyter / Colab
# ---------------------------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py

# ---------------------------------------------------------------------------
# ML / Data — JAMAIS dans Git
# ---------------------------------------------------------------------------
# Datasets bruts ou volumineux — UNIQUEMENT a la racine du repo,
# pas src/deepvision/data/ qui contient le code source.
/data/
/data/raw/
/data/processed/
/data/external/
/data/interim/
*.csv
*.tsv
*.parquet
*.feather
*.arrow
*.npz
*.npy

# Modèles entraînés (utiliser MLflow Registry à la place)
models/*.h5
models/*.keras
models/*.pb
models/*.tflite
models/*.onnx
models/*.ckpt
models/*.pt
models/*.pth
models/*.bin
models/*.safetensors
models/saved_model/

# Logs d'entraînement
logs/
runs/
tb_logs/
tensorboard_logs/

# MLflow tracking et artifacts
mlruns/
mlartifacts/
.mlflow/

# Weights & Biases
wandb/

# DVC (si utilisé plus tard)
.dvc/cache/
.dvc/tmp/
.dvcignore

# ---------------------------------------------------------------------------
# Docker / containerisation
# ---------------------------------------------------------------------------
.docker/
docker-compose.override.yml

# ---------------------------------------------------------------------------
# Tests & qualité
# ---------------------------------------------------------------------------
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.cache/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/

# Linters et type checkers
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# pre-commit
.pre-commit-cache/

# ---------------------------------------------------------------------------
# Documentation builds
# ---------------------------------------------------------------------------
docs/_build/
docs/site/
site/
_build/

# ---------------------------------------------------------------------------
# IDE / Éditeurs
# ---------------------------------------------------------------------------
.idea/
.vscode/
!.vscode/settings.json.example
!.vscode/extensions.json
*.swp
*.swo
*~
.spyderproject
.spyproject
.ropeproject

# ---------------------------------------------------------------------------
# OS
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ---------------------------------------------------------------------------
# Microsoft Office — fichiers de verrou (lock files Word/Excel/PowerPoint)
# ---------------------------------------------------------------------------
~$*
*.docx#
*.xlsx#
*.pptx#

# ---------------------------------------------------------------------------
# Secrets / credentials — JAMAIS dans Git
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
credentials.json
secrets.json
.aws/
.gcp/

# ---------------------------------------------------------------------------
# Caches divers
# ---------------------------------------------------------------------------
.keras/
~/.keras/
.cache/

# ---------------------------------------------------------------------------
# Artefacts temporaires
# ---------------------------------------------------------------------------
tmp/
temp/
*.tmp
*.bak
*.log
