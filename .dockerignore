# =============================================================================
# .dockerignore - exclude everything not strictly needed for image builds.
#
# Goals
# -----
# - Keep the build context small (faster `docker build`, smaller layers).
# - Avoid leaking local secrets (.env), local datasets (data/), trained
#   artefacts (models/) and MLflow tracking history (mlruns/) into images.
# - Drop dev-only tooling caches and IDE settings.
# =============================================================================

# --- Python --------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
build/
dist/
.eggs/
.python-version

# --- Virtual environments -----------------------------------------------
.venv/
venv/
env/
ENV/

# --- Tooling caches -----------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/

# --- Source control / metadata ------------------------------------------
.git/
.gitignore
.gitattributes
.github/

# --- Editor / IDE -------------------------------------------------------
.idea/
.vscode/
.cursor/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Project artefacts that must NOT enter images -----------------------
# Local datasets (CIFAR-10 binaries, CIFAR-10-C, etc.) - reproducible
# from tf.keras.datasets at runtime, no reason to ship them.
data/

# Trained model checkpoints - mounted at runtime via bind volume
# (cf. docker-compose.yml ./models:/app/models:ro). Re-baking them into
# the image would slow CI by hundreds of MB and tie the image to one
# specific weights snapshot.
models/

# MLflow tracking store - generated by training runs, never required
# to run the API or the Streamlit demo.
mlruns/
mlartifacts/

# --- Docs / notebooks ---------------------------------------------------
docs/
Notebooks/
notebooks/
*.ipynb
*.ipynb_checkpoints

# --- Tests --------------------------------------------------------------
tests/

# --- Local secrets ------------------------------------------------------
.env
.env.*
!.env.example

# --- Misc ---------------------------------------------------------------
*.log
*.pid
*.sock
*.bak
*.tmp
*.zip
*.tar.gz

# --- Nested Docker artefacts (so multi-stage builds dont recursively
# copy the Dockerfiles into the build context) ---------------------------
docker-compose*.yml
docker/
