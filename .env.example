# =============================================================================
# .env.example - sample environment for `docker compose up` (Phase 7).
#
# Copy this file to `.env` and fill the blanks. The real `.env` is git-ignored
# AND docker-ignored, so secrets stay out of images and out of remote history.
#
#   cp .env.example .env
#   docker compose up
# =============================================================================

# -----------------------------------------------------------------------------
# DeepVision API (FastAPI) -- consumed by `deepvision.config.Settings`
# -----------------------------------------------------------------------------
# Optional API key. When set, every /predict* request must carry the matching
# value in the `X-API-Key` header. Leave empty to expose an open demo.
DEEPVISION_API_KEY=

# Path INSIDE the container to a trained .keras / SavedModel artefact.
# Mounted via the `./models:/app/models:ro` bind volume in compose, so
# `./models/best.keras` on the host -> `/app/models/best.keras` here.
# Leave empty to serve a randomly-initialised EfficientNetB0 (smoke tests).
DEEPVISION_MODEL_PATH=

# Logging
DEEPVISION_LOG_LEVEL=info
DEEPVISION_LOG_FORMAT=text

# -----------------------------------------------------------------------------
# MLflow tracking -- the api/streamlit/training services point at the mlflow
# container service via its docker-compose hostname.
# -----------------------------------------------------------------------------
MLFLOW_TRACKING_URI=http://mlflow:5000

# -----------------------------------------------------------------------------
# Grafana admin credentials -- CHANGE BEFORE EXPOSING PUBLICLY.
# -----------------------------------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
